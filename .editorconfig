# EditorConfig — consistent formatting across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust uses 4-space indentation (matches rustfmt defaults).
[*.rs]
indent_size = 4

# Markdown: trailing whitespace can be a hard line break, so don't trim it.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
