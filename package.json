{
  "name": "jterm",
  "private": true,
  "version": "0.1.0",
  "description": "A fast, native terminal for macOS and Windows with tabs, split panes, and full mouse support",
  "license": "MIT",
  "author": "Yosef Ashenafi",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefAshenafi/jterm.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
